# Exemple de configuration — aucune valeur secrète dans Git
# Adapter le nom du fichier chargé par Prisma / Next.js dans l'implémentation.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/maktaba_malikiya?schema=public
# Doit commencer par sk_test_ ; jamais de clé live en V1.
STRIPE_SECRET_KEY=
# Secret webhook propre au endpoint/environnement ; généralement whsec_...
STRIPE_WEBHOOK_SECRET=
# Clé publique facultative si flux Checkout redirection la nécessite
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
# Expéditeur à renseigner uniquement une fois utilisable/vérifié chez Resend
RESEND_FROM_EMAIL=
# Pays pris en charge — à confirmer commercialement avant production
SHIPPING_ALLOWED_COUNTRIES=FR,BE,DE,ES,IT,LU,NL
# Aucune configuration Stripe Live autorisée en V1
