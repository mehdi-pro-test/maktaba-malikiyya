# Local PostgreSQL only; never reuse trust authentication for a remote database.
DATABASE_URL=postgresql://maktaba@127.0.0.1:5432/maktaba
APP_URL=http://localhost:3000
SHIPPING_ALLOWED_COUNTRIES=FR,BE,DE,ES,IT,LU,NL
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# V1.4: closed by default. Enable data flags only after the additive migration.
ADMIN_DATA_ENABLED=false
ADMIN_ENABLED=false
QUIZ_DB_ENABLED=false
ADMIN_EMAIL=
ADMIN_USER_ID=
BETTER_AUTH_SECRET=
# Persistent covers: exact store hostname, never a URL or client-side token.
BLOB_READ_WRITE_TOKEN=
ADMIN_BLOB_HOST=
# Private CLI only: configure temporarily outside Git, then remove.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_RECOVERY_PASSWORD=
# V1.5: enable only after the member-accounts migration and auth configuration.
MEMBER_ACCOUNTS_ENABLED=false
