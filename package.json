{
  "name": "maktaba-malikiya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "email:retry": "tsx scripts/email-retry.ts",
    "catalog:update": "tsx scripts/catalog-update.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vercel:build": "tsx scripts/vercel-build.ts",
    "vercel:setup": "tsx scripts/vercel-build.ts --setup",
    "admin:bootstrap": "node --conditions=react-server --import tsx scripts/admin-bootstrap.ts",
    "admin:recovery": "node --conditions=react-server --import tsx scripts/admin-recovery.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-slot": "^1.2.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.13",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@better-auth/utils": "0.5.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
